# Generate an independent random bearer token containing at least 32 characters.
RELAY_TOKEN=replace-with-a-long-random-value

# Provider credentials remain only on this server.
PROVIDER_API_KEY=replace-with-the-provider-api-key
# This is the same QCRI project endpoint used by new_simulations/.
PROVIDER_BASE_URL=https://qcri-sakina-02.services.ai.azure.com/api/projects/qcri-sakina-02/openai/v1/
PROVIDER_MODEL=gpt-4.1

RELAY_MAX_REQUEST_BYTES=2097152
RELAY_MAX_OUTPUT_TOKENS=4000
RELAY_TIMEOUT_SECONDS=180
RELAY_HOST=127.0.0.1
RELAY_PORT=8001

# Optional. Leave blank to let ngrok assign a free temporary URL. The temporary
# URL changes after a tunnel restart. Never put the other website's domain here.
RELAY_NGROK_DOMAIN=

# Preferred local inspector address. The launcher uses it when supported and
# otherwise discovers the port selected automatically by ngrok.
NGROK_WEB_ADDR=127.0.0.1:4041
# NGROK_BIN=/home/local/QCRI/your-user/bin/ngrok

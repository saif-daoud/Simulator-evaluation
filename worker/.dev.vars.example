# Production can use the shared ngrok gateway's isolated relay path.
LLM_RELAY_BASE_URL=https://polka-evasive-pleat.ngrok-free.dev/simulator-evaluation-relay/api
LLM_RELAY_TOKEN=replace-with-the-same-random-relay-token-as-the-qcri-server
# For direct local provider testing, remove LLM_RELAY_BASE_URL from the local
# Wrangler configuration and set one of these instead:
# AZURE_OPENAI_API_KEY=replace-with-a-dedicated-azure-openai-key
# OPENAI_API_KEY=replace-with-a-dedicated-openai-project-key
STUDY_ACCESS_CODE=replace-with-a-new-study-access-code
TOKEN_SECRET=replace-with-a-long-random-value

# Set true only for local UI testing without OpenAI API calls.
MOCK_OPENAI=false
